# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RECALL_API_KEY: Enables "Online Session" capture. The Saga Scribe bot joins Google Meet / Zoom calls
# through Recall.ai (https://www.recall.ai). Without it, live and upload capture still work.
RECALL_API_KEY=""
# RECALL_REGION: Region of your Recall.ai workspace (us-east-1, us-west-2, eu-central-1, ap-northeast-1).
RECALL_REGION="us-east-1"
# SAGASCRIBE_BOT_NAME: Display name the recording bot uses in the call.
SAGASCRIBE_BOT_NAME="SagaScribe-Recorder"

# CAPTURE_TRANSCRIBE_MODEL: Gemini model used for speaker-identified transcription.
CAPTURE_TRANSCRIBE_MODEL="gemini-3.8-flash"

# FFMPEG_PATH: Optional. Audio extraction uses the bundled ffmpeg-static binary unless this is set.
FFMPEG_PATH=""

# VITE_DROPBOX_APP_KEY: Optional. Dropbox app key (PKCE, no secret) to enable Dropbox backups.
# Register <APP_URL>/dropbox-callback.html as a redirect URI in the Dropbox app console.
VITE_DROPBOX_APP_KEY=""
